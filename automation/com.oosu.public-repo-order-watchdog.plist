<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.oosu.public-repo-order-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.local/share/oosuhada-repo-order-watchdog/watch-public-repo-order.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>GITHUB_REPOSITORY_OWNER</key>
    <string>oosuhada</string>
    <key>PROFILE_REPOSITORY</key>
    <string>oosuhada</string>
    <key>PUSH_DELAY_SECONDS</key>
    <string>3</string>
    <key>RECOVERY_GRACE_SECONDS</key>
    <string>120</string>
    <key>PRIMARY_STALE_SECONDS</key>
    <string>1800</string>
    <key>MIN_LOCAL_HOUR</key>
    <string>5</string>
    <key>WATCH_TIMEZONE</key>
    <string>Asia/Seoul</string>
    <key>GIT_AUTHOR_NAME</key>
    <string>Repository Order Bot</string>
    <key>GIT_AUTHOR_EMAIL</key>
    <string>repo-order-bot@users.noreply.github.com</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>43</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>13</integer>
      <key>Minute</key>
      <integer>43</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>21</integer>
      <key>Minute</key>
      <integer>43</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/oosu-public-repo-order-watchdog.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/oosu-public-repo-order-watchdog-error.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
